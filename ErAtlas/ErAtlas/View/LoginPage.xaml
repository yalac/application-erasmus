<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
              x:Class="ErAtlas.View.LoginPage"
             Title="Connexion"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#0F0A1A">

    <Grid Padding="24">
        <Border Style="{StaticResource ModalCard}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="#1A1625">
            <VerticalStackLayout Spacing="14" MaximumWidthRequest="420">
                <Label Text="Connexion"
                       Style="{StaticResource DarkPageTitle}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Accédez à votre espace ErAtlas"
                       Style="{StaticResource DarkPageSubtitle}"
                       HorizontalTextAlignment="Center" />

                <!-- Login et Mot de passe, avec fonctionnalité pour la validation par la touche "entrée" -->
                <Entry x:Name="UsernameEntry"
                       Placeholder="Nom d'utilisateur"
                       ReturnType="Next"
                       Completed="OnUsernameCompleted"
                       Style="{StaticResource DarkEntry}"
                       Text="{Binding Username}" />

                <Entry x:Name="PasswordEntry"
                       Placeholder="Mot de passe"
                       ReturnType="Go"
                       IsPassword="True"
                       Completed="OnPasswordCompleted" 
                       Style="{StaticResource DarkEntry}"
                       Text="{Binding Password}" />
                <!-- -->
                
                <Button Text="Connexion"
                        Command="{Binding LoginCommand}"
                        FontAttributes="Bold"
                        CornerRadius="10" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="#F87171"
                       FontSize="12"
                       IsVisible="{Binding IsErrorVisible}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
             xmlns:model="clr-namespace:ErAtlas.Model"
             x:Class="ErAtlas.LoginPage"
             Title="Connexion"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="#F5F5F5">

    <Grid Padding="24">
        <VerticalStackLayout Spacing="12" VerticalOptions="Center" MaximumWidthRequest="420">
            <Label Text="Connexion"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Entry Placeholder="Nom d'utilisateur"
                   Text="{Binding Username}"
                   BackgroundColor="White" />

            <Entry Placeholder="Mot de passe"
                   IsPassword="True"
                   Text="{Binding Password}"
                   BackgroundColor="White" />

            <Button Text="Connexion"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#0D47A1"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8" />


            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding IsErrorVisible}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
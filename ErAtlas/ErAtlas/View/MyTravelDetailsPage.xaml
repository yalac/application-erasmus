<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
             xmlns:m="clr-namespace:ErAtlas.Model"
             x:Class="ErAtlas.View.MyTravelDetailsPage"
             x:DataType="vm:MyTravelDetailsViewModel"
             BackgroundColor="#080017">
    
    <ContentPage.Content>
        <ScrollView>
            <Grid Padding="24,18" RowDefinitions="Auto,Auto,*" RowSpacing="16" BackgroundColor="#080017">
                
                <!-- Header avec bouton retour -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="←"
                            FontSize="34"
                            BackgroundColor="#A44AF7"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            WidthRequest="40"
                            HeightRequest="40"
                            Clicked="OnBackButtonClicked" />
                    <Label Grid.Column="1"
                           Text="Détails du Trajet"
                           TextColor="White"
                           FontSize="26"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Trajet (Route) -->
                <Border Grid.Row="1"
                        BackgroundColor="#1a0f2e"
                        Stroke="#3D2B66"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <!-- Icon et Statut -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="0"
                                    WidthRequest="70"
                                    HeightRequest="70">
                                <Border.Background>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#AF56EC" Offset="0.1" />
                                        <GradientStop Color="#E34DA5" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Image Source="{Binding Trajet.IconSource}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       WidthRequest="34"
                                       HeightRequest="34"
                                       Aspect="AspectFit" />
                            </Border>
                            
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="Trajet"
                                       TextColor="#BDA6E9"
                                       FontSize="14" />
                                <Label Text="{Binding Trajet.Route}"
                                       TextColor="#e8e3f0"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="#1e2559"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,0"
                                    HeightRequest="30"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Trajet.Statut}"
                                       TextColor="#50a2e4"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- Séparateur -->
                        <BoxView Grid.Row="1"
                                 HeightRequest="1"
                                 BackgroundColor="#3A2A63"
                                 Margin="0,8,0,8" />

                        <!-- Informations du Transport -->
                        <VerticalStackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Transport"
                                   TextColor="#BDA6E9"
                                   FontSize="14"
                                   FontAttributes="Bold" />
                            
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                <Label Grid.Column="0"
                                       Text="Type :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.Transport.TypeTransport, StringFormat='{0:G}'}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Immatriculation :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.Transport.Immatriculation}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Description :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.Transport.Description}"
                                       TextColor="#e8e3f0"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Lieu de Départ -->
                <Border Grid.Row="2"
                        BackgroundColor="#1a0f2e"
                        Stroke="#3D2B66"
                        StrokeShape="RoundRectangle 20"
                        Padding="16"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📍 Lieu de Départ"
                               TextColor="#BDA6E9"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Nom :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuDepart.Nom}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Adresse :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuDepart.Adresse}"
                                       TextColor="#e8e3f0"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Ville :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuDepart.Ville}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Code postal :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuDepart.CodePostal}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Pays :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuDepart.Pays}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Date :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.DateDepart, StringFormat='{0:Le dd MMMM yyyy}'}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Heure :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.HeureDepart, StringFormat='{}{0:hh\\:mm}'}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Lieu d'Arrivée -->
                <Border Grid.Row="2"
                        BackgroundColor="#1a0f2e"
                        Stroke="#3D2B66"
                        StrokeShape="RoundRectangle 20"
                        Padding="16"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🎯 Lieu d'Arrivée"
                               TextColor="#BDA6E9"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Nom :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuArrivee.Nom}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Adresse :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuArrivee.Adresse}"
                                       TextColor="#e8e3f0"
                                       FontSize="13"
                                       LineBreakMode="WordWrap" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Ville :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuArrivee.Ville}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Code postal :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuArrivee.CodePostal}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Pays :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.LieuArrivee.Pays}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Date :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.DateArrivee, StringFormat='{0:Le dd MMMM yyyy}'}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Heure :"
                                       TextColor="#BDA6E9"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       Text="{Binding Trajet.HeureArrivee, StringFormat='{}{0:hh\\:mm}'}"
                                       TextColor="#e8e3f0"
                                       FontSize="13" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Espaceur -->
                <BoxView Grid.Row="2" HeightRequest="20" BackgroundColor="#080017" />
            </Grid>
        </ScrollView>
    </ContentPage.Content>

</ContentPage>

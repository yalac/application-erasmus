<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="using:ErAtlas.ViewModels"
    xmlns:model="using:ErAtlas.Model"
    x:Class="ErAtlas.View.MainPage"
    x:DataType="vm:MainPageViewModel"
    BackgroundColor="#0F0A1A"
    Title="Accueil">
    
    
    <ContentPage.Resources>
        <Style x:Key="TransportCard" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="#1A1625" />
            <Setter Property="BorderColor" Value="#2D2440" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HasShadow" Value="True" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="32" Padding="24">

            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Planifiez votre trajet" Style="{StaticResource DarkPageTitle}" />
                <Label Text="Trouvez rapidement les meilleures options" Style="{StaticResource DarkPageSubtitle}" />
            </VerticalStackLayout>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <!-- Nombre total de trajets -->
                <Border BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding TotalTrajets}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                        <Label Text="Trajets au total" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Nombre de trajets en cours -->
                <Border Grid.Column="1"
                        BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding TrajetsEnCoursCount}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                        <Label Text="En cours" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <!-- Nombre de trajets terminés -->
                <Border Grid.Column="2"
                        BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding TrajetsTerminesCount}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                        <Label Text="Terminés" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <!-- Moyens de transport -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Moyens de transport" TextColor="White" FontSize="18" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,16,*,16,*,16,*">
                    <!-- Avion -->
                    <Frame Grid.Column="0" Style="{StaticResource TransportCard}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Border Style="{StaticResource TransportTile}">
                                <Image Source="avion.svg" Style="{StaticResource TransportTileIcon}" />
                            </Border>
                            <Label Text="Avion" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Train -->
                    <Frame Grid.Column="2" Style="{StaticResource TransportCard}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Border Style="{StaticResource TransportTile}">
                                <Image Source="train.svg" Style="{StaticResource TransportTileIcon}" />
                            </Border>
                            <Label Text="Train" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Bus -->
                    <Frame Grid.Column="4" Style="{StaticResource TransportCard}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Border Style="{StaticResource TransportTile}">
                                <Image Source="bus.svg" Style="{StaticResource TransportTileIcon}" />
                            </Border>
                            <Label Text="Bus" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Bateau -->
                    <Frame Grid.Column="6" Style="{StaticResource TransportCard}">
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Border Style="{StaticResource TransportTile}">
                                <Image Source="bateau.svg" Style="{StaticResource TransportTileIcon}" />
                            </Border>
                            <Label Text="Bateau" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>
            </VerticalStackLayout>

            <!-- Trajets récents -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Trajets récents" TextColor="White" FontSize="18" FontAttributes="Bold" />
                <Frame CornerRadius="16" BackgroundColor="#1A1625" BorderColor="#2D2440" Padding="16">
                    <CollectionView ItemsSource="{Binding TrajetsRecent}"
                                    ItemsLayout="VerticalList"
                                    SelectionMode="None">
                        <!-- Exemple de ItemTemplate -->
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:Trajet">
                                <Frame CornerRadius="12" BackgroundColor="#241149" Padding="12" Margin="0,8">
                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                        <!-- Icône du transport -->
                                        <Border Style="{StaticResource TransportTile}"
                                                WidthRequest="46"
                                                HeightRequest="46"
                                                Padding="8">
                                            <Image Source="{Binding IconSource}" Style="{StaticResource TransportTileIcon}" WidthRequest="24" HeightRequest="24" />
                                        </Border>

                                        <!-- Informations du trajet -->
                                        <VerticalStackLayout Spacing="4">
                                            <!-- VilleDepart → VilleArrivee -->
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding VilleDepart}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                                <Label Text=" → " TextColor="White" FontAttributes="Bold" FontSize="14" />
                                                <Label Text="{Binding VilleArrivee}" TextColor="White" FontAttributes="Bold" FontSize="14" />
                                            </HorizontalStackLayout>

                                            <!-- DateDepart + HeureDepart -->
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="{Binding DateDepart, StringFormat='{0:dd/MM/yyyy}'}" TextColor="#B8A0E0" FontSize="12" />
                                                <Label Text=" à " TextColor="#B8A0E0" FontSize="12" />
                                                <Label Text="{Binding HeureDepart, StringFormat='{0:HH\\:mm}'}" TextColor="#B8A0E0" FontSize="12" />
                                            </HorizontalStackLayout>

                                            <!-- Statut -->
                                            <Label Text="{Binding Statut}" TextColor="#B8A0E0" FontSize="12" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

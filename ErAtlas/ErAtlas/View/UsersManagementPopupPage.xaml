<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
             x:Class="ErAtlas.View.UsersManagementPopupPage"
             x:DataType="vm:UsersManagementViewModel"
             Title="Formulaire de création d'utilisateur"
             BackgroundColor="#66000000">

    <Grid Padding="24">
        <Border HorizontalOptions="Center" VerticalOptions="Center"
                WidthRequest="520" MaximumHeightRequest="720"
                BackgroundColor="White"
                Padding="20" StrokeShape="RoundRectangle 16">

            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding FormulaireTitre}" FontSize="22" FontAttributes="Bold" TextColor="Black" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Nom :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Entrez votre nom" Text="{Binding Nom}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Prénom :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Entrez votre prénom" Text="{Binding Prenom}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Email :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="prenom.nom@domaine.fr" Text="{Binding Email}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Login :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Entrez votre login" Text="{Binding Login}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Mot de passe :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Saisissez votre mot de passe" Text="{Binding MotDePasse}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Téléphone :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="0612345678" Text="{Binding NumeroTelephone}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Adresse :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Entrez votre adresse" Text="{Binding Adresse}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Code postal :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" /> 
                        <Entry Placeholder="27910" Text="{Binding CodePostal}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Ville :" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Entry Placeholder="Entrez votre ville" Text="{Binding Ville}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="Gestionnaire (off/on)" WidthRequest="120" VerticalOptions="Center" TextColor="#555555" />
                        <Switch IsToggled="{Binding Gestionnaire}" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding IsErrorVisible}" />

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                        <Button Text="Annuler" Clicked="OnAnnulerClicked" BackgroundColor="#9E9E9E" TextColor="White" CornerRadius="8" />
                        <Button Text="Créer" Clicked="OnCreerClicked" BackgroundColor="#2E7D32" TextColor="White" CornerRadius="8" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>



<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
             xmlns:m="clr-namespace:ErAtlas.Model"
             x:Name="PageRoot"
             x:Class="ErAtlas.View.MyTravelPage"
             x:DataType="vm:MyTravelViewModel">
    <ContentPage.Content>

        <Grid Padding="24,18" RowDefinitions="Auto,*" BackgroundColor="#080017">
            <Label Text="Mes Trajets"
                   TextColor="White"
                   FontSize="26"
                   FontAttributes="Bold"
                   Margin="0,0,0,16" />

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Travels}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                                     VerticalItemSpacing="18"
                                     HorizontalItemSpacing="18" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Trajet">
                        <Border BackgroundColor="#1A0E3A"
                                Stroke="#3D2B66"
                                StrokeShape="RoundRectangle 20"
                                Padding="16"
                                MinimumHeightRequest="230">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*,Auto"
                                  RowSpacing="8">
                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        BackgroundColor="#C24CF5"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="0"
                                        WidthRequest="70"
                                        HeightRequest="70">
                                    <Image Source="{Binding IconSource}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           WidthRequest="34"
                                           HeightRequest="34"
                                           Aspect="AspectFit" />
                                </Border>

                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        BackgroundColor="#173A8A"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14,6"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding Statut}"
                                           TextColor="#7CC6FF"
                                           FontSize="14"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Text="Trajet"
                                       TextColor="#BDA6E9"
                                       FontSize="16"
                                       Margin="0,4,0,0" />

                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding Route}"
                                       TextColor="White"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Grid Grid.Row="4"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*"
                                      Margin="0,6,0,0">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Date"
                                               TextColor="#BDA6E9"
                                               FontSize="16" />
                                        <Label Text="{Binding DateDepart}"
                                               TextColor="White"
                                               FontSize="30"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Date"
                                               TextColor="#BDA6E9"
                                               FontSize="16" />
                                        <Label Text="{Binding DateArrivee}"
                                               TextColor="White"
                                               FontSize="30"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>
                                

                                <BoxView Grid.Row="6"
                                         Grid.ColumnSpan="3"
                                         HeightRequest="1"
                                         BackgroundColor="#3A2A63"
                                         Margin="0,4,0,4" />

                                <Grid Grid.Row="7"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            Text="Détails"
                                            BackgroundColor="#A44AF7"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="16"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ShowDetailsCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"
                                            Text="Modifier"
                                            BackgroundColor="#3A246C"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="16"
                                            Padding="22,0"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditTravelCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

    </ContentPage.Content>
</ContentPage>
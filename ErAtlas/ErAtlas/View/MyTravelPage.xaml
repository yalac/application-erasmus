<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ErAtlas.ViewModels"
             xmlns:m="clr-namespace:ErAtlas.Model"
             x:Name="PageRoot"
             x:Class="ErAtlas.View.MyTravelPage"
             x:DataType="vm:MyTravelViewModel">
    <ContentPage.Content>

        <Grid Padding="24,18" RowDefinitions="Auto,*" BackgroundColor="#080017">
            <Label Text="Mes Trajets"
                   Style="{StaticResource DarkPageTitle}"
                   Margin="0,0,0,16" />

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Travels}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                     Span="{OnIdiom Phone=1, Tablet=2, Desktop=3}"
                                     VerticalItemSpacing="18"
                                     HorizontalItemSpacing="18" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Trajet">
                        <Border Style="{StaticResource SurfaceCard}"
                                MinimumHeightRequest="230">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*,Auto"
                                  RowSpacing="8">
                                
                                <!-- Icon -->
                                <Border Grid.Row="0"
                                        Grid.Column="0"
                                        Style="{StaticResource TransportTile}">
                                    <Image Source="{Binding IconSource}"
                                           Style="{StaticResource TransportTileIcon}" />
                                </Border>
                                
                                <!-- Status -->
                                <Border Grid.Row="0"
                                        Grid.Column="2"
                                        BackgroundColor="#241149"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,0"
                                        HeightRequest="30"
                                        MinimumHeightRequest="30"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Statut}"
                                           TextColor="#A78BFA"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Text="Trajet"
                                       Style="{StaticResource DarkPageSubtitle}"
                                       Margin="0,8,0,0" />

                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding Route}"
                                        TextColor="White"
                                        FontSize="20"
                                        FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <!-- Dates ~ Départ et Arrivée -->
                                <Grid Grid.Row="4"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*"
                                      Margin="0,8,0,0">
                                    <!-- Départ -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Date de départ" Style="{StaticResource DarkPageSubtitle}" />
                                        <Label Text="{Binding DateDepart, StringFormat='{0:Le dd MMMM yyyy}'}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding HeureDepart, StringFormat='{}{0:hh\\:mm}'}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <!-- Arrivée -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Date d'arrivée" Style="{StaticResource DarkPageSubtitle}" />
                                        <Label Text="{Binding DateArrivee, StringFormat='{0:Le dd MMMM yyyy}'}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding HeureArrivee, StringFormat='{}{0:hh\\:mm}'}"
                                               TextColor="White"
                                               FontSize="20"
                                               FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                </Grid>
                                

                                <BoxView Grid.Row="6"
                                         Grid.ColumnSpan="3"
                                         HeightRequest="1"
                                         BackgroundColor="#2D2440"
                                         Margin="0,4,0,4" />

                                <Grid Grid.Row="7"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            Text="Détails"
                                            BackgroundColor="#A44AF7"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="16"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ShowDetailsCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Grid.Column="1"
                                            Text="Modifier"
                                            BackgroundColor="#3A246C"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="16"
                                            Padding="22,0"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditTravelCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ContentPage.Content>
</ContentPage>
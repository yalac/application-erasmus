<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="using:ErAtlas.ViewModels"
             x:Class="ErAtlas.View.MyTravelPage"
             x:DataType="vm:MyTravelViewModel"
             BackgroundColor="#0F0A1A"
             Title="Mes trajets">

    <ContentPage.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#8B5CF6" Offset="0.0" />
                        <GradientStop Color="#EC4899" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="PlaceholderColor" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="46" />
        </Style>

        <Style x:Key="FilterPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="TitleColor" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="46" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24">

            <!-- Header -->
            <Border BackgroundColor="#1A1625"
                    Stroke="#2D2440"
                    StrokeShape="RoundRectangle 28"
                    Padding="22">
                <Border.Shadow>
                    <Shadow Brush="#8B5CF6" Offset="0,8" Radius="20" Opacity="0.18" />
                </Border.Shadow>

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mes trajets"
                               TextColor="White"
                               FontSize="28"
                               FontAttributes="Bold" />
                        <Label Text="Retrouvez et gérez tous vos déplacements en un seul endroit"
                               TextColor="#B8A0E0"
                               FontSize="13"
                               Opacity="0.9" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="+ Nouveau trajet"
                            Style="{StaticResource RoundedButton}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Travels.Count}"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="Trajets" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1"
                        BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="•"
                               TextColor="#EC4899"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="En cours" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#1A1625"
                        Stroke="#2D2440"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="•"
                               TextColor="#10B981"
                               FontSize="24"
                               FontAttributes="Bold" />
                        <Label Text="Terminés" TextColor="#B8A0E0" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Filtres -->
            <Border BackgroundColor="#1A1625"
                    Stroke="#2D2440"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Filtres"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <Border BackgroundColor="#0F0A1A"
                                Stroke="#2D2440"
                                StrokeShape="RoundRectangle 14"
                                Padding="10">
                            <Entry Style="{StaticResource FilterEntry}"
                                   Placeholder="Rechercher un trajet..." />
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="#0F0A1A"
                                Stroke="#2D2440"
                                StrokeShape="RoundRectangle 14"
                                Padding="10">
                            <Picker Style="{StaticResource FilterPicker}"
                                    Title="Tous les transports" />
                        </Border>

                        <Border Grid.Column="4"
                                BackgroundColor="#0F0A1A"
                                Stroke="#2D2440"
                                StrokeShape="RoundRectangle 14"
                                Padding="10">
                            <Picker Style="{StaticResource FilterPicker}"
                                    Title="Tous les statuts" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Liste -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Liste des trajets"
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding Travels}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TravelCardItem">
                            <Border BackgroundColor="#1A1625"
                                    Stroke="#2D2440"
                                    StrokeShape="RoundRectangle 24"
                                    Padding="18">
                                <Border.Shadow>
                                    <Shadow Brush="#8B5CF6" Offset="0,6" Radius="18" Opacity="0.15" />
                                </Border.Shadow>

                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="Auto,*,Auto"
                                      RowSpacing="10"
                                      ColumnSpacing="14">

                                    <!-- Icône -->
                                    <Border BackgroundColor="#8B5CF6"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="14"
                                            WidthRequest="58"
                                            HeightRequest="58">
                                        <Label Text="{Binding IconGlyph}"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Infos -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding RouteText}"
                                               TextColor="White"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding DateText}"
                                               TextColor="#B8A0E0"
                                               FontSize="13" />

                                        <Label Text="{Binding TimeText}"
                                               TextColor="#D8CCFF"
                                               FontSize="13" />
                                    </VerticalStackLayout>

                                    <!-- Statut -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{Binding StatusBackgroundColor}"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,7"
                                            VerticalOptions="Start">
                                        <Label Text="{Binding StatusText}"
                                               TextColor="{Binding StatusTextColor}"
                                               FontSize="12"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <!-- Via -->
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Text="{Binding ViaText}"
                                           TextColor="#D8CCFF"
                                           FontSize="13"
                                           IsVisible="{Binding HasVia}" />

                                    <!-- Tags -->
                                    <HorizontalStackLayout Grid.Row="2"
                                                           Grid.ColumnSpan="3"
                                                           Spacing="8"
                                                           IsVisible="{Binding HasTransportModes}"
                                                           BindableLayout.ItemsSource="{Binding TransportModes}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border BackgroundColor="#241149"
                                                        StrokeShape="RoundRectangle 12"
                                                        Padding="10,6">
                                                    <Label Text="{Binding .}"
                                                           TextColor="#E9D9FF"
                                                           FontSize="12"
                                                           FontAttributes="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

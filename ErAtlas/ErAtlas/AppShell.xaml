<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ErAtlas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ErAtlas"
    xmlns:view="using:ErAtlas.View"
    xmlns:views="using:ErAtlas.Views"
    Title="ErAtlas"
    FlyoutBehavior="Disabled">
    
    <TabBar>
        <!-- Première page -->
        <Tab Title="Accueil">
            <ShellContent ContentTemplate="{DataTemplate view:MainPage}" Route="MainPage" />
        </Tab>
        
        <!-- Deuxième page -->
        <Tab Title="Mes Trajets">
            <ShellContent ContentTemplate="{DataTemplate view:MyTravelPage}" Route="MyTravelPage" />
        </Tab>
        
        <!-- Troisième page -->
        <Tab Title="Gestion des trajets">
            <ShellContent ContentTemplate="{DataTemplate view:TripManagementPage}" Route="TripManagementPage" />
        </Tab>
        
        <!-- Quatrième page -->
        <Tab Title="Gestion des utilisateurs">
            <ShellContent ContentTemplate="{DataTemplate view:UsersManagementPage}" Route="UsersManagementPage" />
        </Tab>
        
        <!-- Cinquième page -->
        <Tab Title="Paramètres">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>
</Shell>